#!/usr/bin/env python3
"""Hermes command TTS provider: say-http VOICE TEXT_FILE OUTPUT_WAV
Posts the text to the local Pocket TTS server (Kyutai's reference implementation in the
`pocket-tts` container, model kept warm) and writes a WAV with a corrected header, since the
server streams with placeholder sizes."""
import os, struct, sys, uuid, urllib.request

URL = os.environ.get("POCKET_TTS_URL", "http://127.0.0.1:8131/tts")
voice, text_path, out_path = sys.argv[1:4]
text = open(text_path, encoding="utf-8").read().strip()
boundary = uuid.uuid4().hex
fields = [("text", text)] + ([("voice_url", voice)] if voice else [])
body = b"".join(
    f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n".encode() for k, v in fields
) + f"--{boundary}--\r\n".encode()
req = urllib.request.Request(URL, data=body, method="POST",
                             headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
with urllib.request.urlopen(req, timeout=120) as resp:
    wav = bytearray(resp.read())

# Fix RIFF and data chunk sizes.
if wav[:4] == b"RIFF" and wav[8:12] == b"WAVE":
    pos = 12
    while pos + 8 <= len(wav):
        cid, size = wav[pos:pos + 4], struct.unpack_from("<I", wav, pos + 4)[0]
        if cid == b"data":
            struct.pack_into("<I", wav, pos + 4, len(wav) - pos - 8)
            break
        pos += 8 + size + (size & 1)
    struct.pack_into("<I", wav, 4, len(wav) - 8)
with open(out_path, "wb") as out:
    out.write(wav)
